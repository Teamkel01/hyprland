{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "memory", "battery"],
    "clock": {"format": "{:%H:%M}"},
    "pulseaudio": {"format": "  {volume}%"},
    "memory": {"format": "  {percentage}%"},
    "battery": {"format": "  {capacity}%"}
}
